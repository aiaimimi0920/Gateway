# Rust and Tauri build output
/target/
/crates/*/target/
**/.ng/
/.linux-target/
/apps/desktop/src-tauri/target/
/apps/desktop/target/
**/*.rs.bk

# Node dependencies and generated frontend output
/scripts/node_modules/
/scripts/.runtime/
/scripts/output/
/scripts/tmp-*
/apps/desktop/node_modules/
/apps/desktop/dist/
/apps/desktop/.rsbuild/
/apps/desktop/test-results/
*.tsbuildinfo

# Importable copies written by scripts/tests/gemini-canvas-browser-pool.test.mjs
/scripts/tests/.gemini-canvas-browser-pool-testable-*.mjs

# Browser helper screenshots saved when no output path is supplied
/undefined/
/scripts/undefined/

# Runtime state, release packages, evidence output, and local scratch
/.runtime/
/.gateway-state/
/gateway/
/release/
/output/
/evidence/
/artifacts/
/.tmp/
/*.log
/tmp-*
/_temp/
/temp/
/tmp/

# Local configuration and credentials. Versioned route configuration remains
# tracked for the current private development workflow.
/.env
/.env.*
!/.env.example
/deploy/.env
/deploy/gateway_data/
/deploy/redis_data/

# Local Codex/browser automation state (never part of source or releases)
/.playwright-cli/
/.playwright-mcp/
/.superpowers/

# Python validation cache
__pycache__/
*.py[cod]
/.pytest_cache/
/.venv/
/venv/

# Editor and operating-system files
/.idea/
/.vscode/
.DS_Store
Thumbs.db
Desktop.ini
*.swp
*.swo

# Gateway is an application repository; retain reproducible lockfiles.
!Cargo.lock
!/apps/desktop/package-lock.json
!/apps/desktop/src-tauri/Cargo.lock
!/scripts/package-lock.json
