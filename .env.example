# Neuro Gateway local runtime example.
# Copy to .env for local development and fill real values locally.
# Do not commit real .env files.

PORT=4200
GATEWAY_RUNTIME_ROLE=standalone
GATEWAY_REDIS_URL=redis://localhost:6379

# Optional database connection for management/state features.
# GATEWAY_DATABASE_URL=postgres://user:password@localhost:5432/neuro_gateway

# Public serving authentication.
# GATEWAY_API_KEY=replace-with-local-public-serving-key
# GATEWAY_API_KEY_SECRET=replace-with-local-project-key-signing-secret
# Live route proof is disabled by default. Enable only on an isolated operator
# instance used for explicit provider canaries; each request must also opt in.
# GATEWAY_LIVE_ROUTE_PROOF_ENABLED=false
# Prefer a transient process environment value for canary authentication.
# GATEWAY_CANARY_API_KEY=replace-with-isolated-canary-key

# Internal management and browser executor authentication.
# GATEWAY_MANAGEMENT_TOKEN=replace-with-local-management-token
# GATEWAY_BROWSER_EXECUTOR_BASE_URL=http://127.0.0.1:4210
# GATEWAY_BROWSER_EXECUTOR_BEARER_TOKEN=replace-with-local-browser-executor-token
# Local development only: internal routes fail closed when tokens are missing.
# Do not enable these overrides in shared or production environments.
# GATEWAY_ALLOW_UNAUTHENTICATED_INTERNAL_ROUTES=false
# GATEWAY_ALLOW_UNAUTHENTICATED_BROWSER_EXECUTOR=false

# Browser-backed request policy:
# - local_allowed: use remote browser executor when configured, otherwise local fallback
# - remote_only: fail closed if the remote browser executor is missing/unreachable
# - disabled: keep request-time browser policy disabled where supported
GATEWAY_REQUEST_TIME_BROWSER_POLICY=local_allowed

# Body limits and timeouts.
GATEWAY_UPSTREAM_TIMEOUT_SECS=120
GATEWAY_MAX_REQUEST_BODY_BYTES=52428800
GATEWAY_RESPONSE_CACHE_TTL_SECS=300
GATEWAY_RESPONSE_CACHE_MAX_SIZE_BYTES=524288

# Provider credential folder sync.
GATEWAY_PROVIDER_CREDENTIAL_FOLDER_SYNC_ENABLED=false
# GATEWAY_PROVIDER_CREDENTIAL_FOLDER_SYNC_ROOT_DIR=C:\path\to\provider-credentials
GATEWAY_PROVIDER_CREDENTIAL_FOLDER_SYNC_INTERVAL_SECS=30
GATEWAY_PROVIDER_CREDENTIAL_FOLDER_SYNC_WATCH_ENABLED=true
GATEWAY_PROVIDER_CREDENTIAL_FOLDER_SYNC_WATCH_DEBOUNCE_MILLIS=1500
GATEWAY_PROVIDER_CREDENTIAL_FOLDER_SYNC_IMPORT_ENABLED=true
GATEWAY_PROVIDER_CREDENTIAL_FOLDER_SYNC_EXPORT_ENABLED=true
GATEWAY_PROVIDER_CREDENTIAL_FOLDER_SYNC_DELETE_MISSING=false

# Provider credential maintenance loops.
GATEWAY_PROVIDER_CREDENTIAL_REFRESH_ENABLED=true
GATEWAY_PROVIDER_CREDENTIAL_REFRESH_INTERVAL_SECS=3600
GATEWAY_PROVIDER_CREDENTIAL_REFRESH_BEFORE_SECS=86400
GATEWAY_PROVIDER_CREDENTIAL_REFRESH_BATCH_LIMIT=100
GATEWAY_PROVIDER_CREDENTIAL_REFRESH_LOCK_TTL_SECS=300
GATEWAY_CREDENTIAL_STOCK_MONITOR_ENABLED=true
GATEWAY_CREDENTIAL_STOCK_MONITOR_INTERVAL_SECS=60

# Splitter/worker runtime.
# GATEWAY_SPLITTER_WORKER_EXECUTABLE_PATH=C:\path\to\neuro-gateway.exe
GATEWAY_SPLITTER_INITIAL_WORKER_PORT=4201
GATEWAY_SPLITTER_READY_TIMEOUT_SECS=120
GATEWAY_SPLITTER_READY_POLL_INTERVAL_MILLIS=500
GATEWAY_SPLITTER_RELOAD_SHUTDOWN_TIMEOUT_SECS=0

# Optional provider/API keys for local experiments only.
# OPENAI_API_KEY=
# TAVILY_API_KEY=
# YOU_API_KEY=
# EXA_API_KEY=
# JINA_API_KEY=
# LINKUP_API_KEY=
