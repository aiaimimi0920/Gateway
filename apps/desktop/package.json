{
  "name": "gateway-ui",
  "version": "0.1.0",
  "description": "Gateway UI desktop shell for local users",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=22.22.0"
  },
  "scripts": {
    "dev": "cross-env GATEWAY_UI_TARGET=tauri rsbuild dev --port 1425",
    "dev:web": "cross-env GATEWAY_UI_TARGET=web rsbuild dev --port 1425",
    "build": "npm run build:tauri",
    "build:web": "cross-env GATEWAY_UI_TARGET=web rsbuild build",
    "build:tauri": "cross-env GATEWAY_UI_TARGET=tauri rsbuild build",
    "preview": "rsbuild preview",
    "tauri": "tauri",
    "audit:prod": "npm audit --omit=dev --audit-level=high",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest",
    "test:watch": "vitest",
    "e2e": "playwright test"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.4.0",
    "@microsoft/fetch-event-source": "^2.0.1",
    "@radix-ui/react-alert-dialog": "^1.1.20",
    "@radix-ui/react-dialog": "^1.1.20",
    "@radix-ui/react-select": "^2.3.4",
    "@radix-ui/react-switch": "^1.3.4",
    "@radix-ui/react-tabs": "^1.1.18",
    "@radix-ui/react-tooltip": "^1.2.13",
    "@tanstack/react-query": "^5.101.4",
    "@tauri-apps/api": "2.11.0",
    "lucide-react": "^1.25.0",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "react-hook-form": "^7.82.0",
    "react-router": "8.3.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@rsbuild/core": "^1.0.0",
    "@rsbuild/plugin-react": "^1.0.0",
    "@tauri-apps/cli": "2.11.2",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^20.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "cross-env": "^10.1.0",
    "jsdom": "^29.1.1",
    "msw": "^2.15.0",
    "typescript": "^5.0.0",
    "vitest": "^4.1.10"
  }
}
