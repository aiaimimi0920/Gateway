{
  "name": "gateway-browser-workers",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.22.0"
  },
  "scripts": {
    "audit:prod": "npm audit --omit=dev --audit-level=high",
    "test:effective-lines": "node --test tests/effective-code-lines.test.mjs tests/effective-code-lines-runtime-artifacts.test.mjs",
    "check:effective-lines": "node effective-code-lines.mjs --mode ratchet --json artifacts/effective-code-lines.json",
    "report:effective-lines": "node effective-code-lines.mjs --mode report --json artifacts/effective-code-lines.json",
    "strict:effective-lines": "node effective-code-lines.mjs --mode strict --json artifacts/effective-code-lines-strict.json"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1033.0",
    "playwright-core": "1.59.1",
    "selfsigned": "3.0.1",
    "ws": "8.21.0"
  }
}
