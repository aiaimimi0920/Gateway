* text=auto eol=lf

# Windows command files are consumed directly by Windows tooling.
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf
*.vbs text eol=crlf

# Keep source and repository configuration stable across platforms.
*.rs text eol=lf
*.toml text eol=lf
*.lock text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.js text eol=lf
*.mjs text eol=lf
*.json text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.md text eol=lf
*.py text eol=lf
*.sh text eol=lf

# Binary release and documentation assets.
*.dll binary
*.exe binary
*.ico binary
*.jpg binary
*.jpeg binary
*.png binary
*.webp binary
*.pdf binary
*.zip binary
