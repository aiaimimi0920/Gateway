FROM node:22-bookworm-slim

RUN node -e 'const minimum = [22, 22, 0]; const current = process.versions.node.split(".").map(Number); const difference = current.findIndex((value, index) => value !== minimum[index]); if (difference >= 0 && current[difference] < minimum[difference]) { throw new Error("Node.js >=22.22.0 is required; found " + process.versions.node); }'

RUN apt-get update \
  && apt-get install -y --no-install-recommends \
    build-essential \
    ca-certificates \
    chromium \
    clang \
    cmake \
    curl \
    git \
    pkg-config \
  && rm -rf /var/lib/apt/lists/*

RUN curl https://sh.rustup.rs -sSf | sh -s -- -y --profile minimal --default-toolchain 1.91.1 \
  && /root/.cargo/bin/rustup component add rustfmt --toolchain 1.91.1-x86_64-unknown-linux-gnu \
  && /root/.cargo/bin/cargo install cargo-watch --locked \
  && /root/.cargo/bin/rustc --version \
  && /root/.cargo/bin/cargo --version \
  && /root/.cargo/bin/rustfmt --version

ENV PATH="/root/.cargo/bin:${PATH}" \
  PORT=4200 \
  GATEWAY_RUNTIME_ROLE=standalone \
  GATEWAY_ROUTES_FILE=/data/routes.yaml \
  GATEWAY_STATE_DIR=/data/state \
  GATEWAY_PREBUILT_WEB_UI=1 \
  GATEWAY_DEV_CARGO_BUILD_JOBS=4 \
  GATEWAY_DEV_CARGO_INCREMENTAL=1

WORKDIR /workspace

COPY deploy/docker-dev-entrypoint.sh /usr/local/bin/gateway-dev-entrypoint

RUN chmod +x /usr/local/bin/gateway-dev-entrypoint \
  && mkdir -p /data/state

ENTRYPOINT ["gateway-dev-entrypoint"]
