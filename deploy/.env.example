# Gateway Docker Compose deployment defaults.
# Copy this file to .env in the same directory before the first deploy.

COMPOSE_PROJECT_NAME=gateway

IMAGE_TAG=latest
GATEWAY_BIND_HOST=0.0.0.0
GATEWAY_PORT=4200
RUST_LOG=info

# Core runtime.
GATEWAY_RUNTIME_ROLE=standalone
GATEWAY_REDIS_URL=redis://redis:6379/0
GATEWAY_ROUTES_FILE=/data/routes.yaml
GATEWAY_STATE_DIR=/data/state

# Optional public/API auth.
# GATEWAY_API_KEY=replace-with-public-api-key
# GATEWAY_API_KEY_SECRET=replace-with-project-key-signing-secret

# Optional management auth and remote console access.
# GATEWAY_MANAGEMENT_TOKEN=replace-with-management-token
GATEWAY_CONSOLE_REMOTE_ACCESS=false

# Optional database-backed features. Leave empty for the current minimal
# service stack; point this at an external PostgreSQL instance if needed.
# GATEWAY_DATABASE_URL=postgres://user:password@postgres:5432/neuro_gateway
