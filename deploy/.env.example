# Gateway Docker Compose deployment defaults.
# Copy this file to .env in the same directory before the first deploy.

COMPOSE_PROJECT_NAME=gateway

IMAGE_TAG=latest
GATEWAY_BIND_HOST=0.0.0.0
GATEWAY_PORT=4200
RUST_LOG=info

# Core runtime.
GATEWAY_RUNTIME_ROLE=standalone
GATEWAY_REDIS_URL=redis://redis:6379/0
GATEWAY_ROUTES_FILE=/data/routes.yaml
GATEWAY_STATE_DIR=/data/state

# Optional public/API auth.
# GATEWAY_API_KEY=replace-with-public-api-key
# GATEWAY_API_KEY_SECRET=replace-with-project-key-signing-secret

# Optional Tokio worker thread stack size in bytes. The gateway defaults to
# 8 MiB to keep browser-backed Gemini requests from overflowing the smaller
# Linux defaults. Override only if you need a different trade-off.
# GATEWAY_TOKIO_WORKER_STACK_BYTES=8388608

# Optional management auth and remote console access.
# GATEWAY_MANAGEMENT_TOKEN=replace-with-management-token
GATEWAY_CONSOLE_REMOTE_ACCESS=false

# Optional database-backed features. Leave empty for the current minimal
# service stack; point this at an external PostgreSQL instance if needed.
# GATEWAY_DATABASE_URL=postgres://user:password@postgres:5432/neuro_gateway

# Optional host browser executor used by Gemini manual add in dev Docker mode.
# GATEWAY_GEMINI_AUTH_EXECUTOR_BASE_URL=http://host.docker.internal:42341
# GATEWAY_GEMINI_AUTH_EXECUTOR_BEARER_TOKEN=gateway-gemini-auth-dev

# Optional credential-pool automation. Route configuration may only reference
# driver IDs from this backend-owned registry; it can never provide a command
# or endpoint directly. Script paths must stay under the allowlisted root.
GATEWAY_CREDENTIAL_POOL_AUTOMATION_ENABLED=true
GATEWAY_CREDENTIAL_POOL_AUTOMATION_INTERVAL_SECS=60
GATEWAY_CREDENTIAL_POOL_AUTOMATION_TIMEOUT_SECS=60
# GATEWAY_CREDENTIAL_POOL_AUTOMATION_DRIVER_CONFIG=/data/credential-pool-drivers.json
# GATEWAY_CREDENTIAL_POOL_AUTOMATION_SCRIPT_ROOT=/data/credential-pool-scripts

# Reliable credential-refill task queue. This queue is independent from the
# direct driver worker above and is enabled by default by the Gateway runtime.
GATEWAY_CREDENTIAL_REFILL_QUEUE_ENABLED=true
GATEWAY_CREDENTIAL_REFILL_NOTIFICATION_INTERVAL_SECS=30
GATEWAY_CREDENTIAL_REFILL_TASK_TTL_SECS=604800
GATEWAY_CREDENTIAL_REFILL_DEFAULT_LEASE_SECS=300
GATEWAY_CREDENTIAL_REFILL_MAX_LEASE_SECS=3600
GATEWAY_CREDENTIAL_REFILL_STREAM_MAX_LEN=10000
