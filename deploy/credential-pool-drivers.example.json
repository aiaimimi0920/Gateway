{
  "drivers": [
    {
      "id": "suno-browser-import",
      "provider_ids": ["suno"],
      "timeout_secs": 300,
      "mode": "script",
      "script": "suno-account-import.ps1"
    },
    {
      "id": "trusted-partner-account-api",
      "provider_ids": ["custom-openai-provider"],
      "timeout_secs": 60,
      "mode": "http",
      "endpoint": "https://account-service.example/internal/gateway/reconcile",
      "secret_env": "GATEWAY_PARTNER_ACCOUNT_API_TOKEN"
    }
  ]
}
