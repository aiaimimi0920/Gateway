  "verification": {
    "recommendedCargoTargetDirSlug": "kiro-official-vendor-api-verify",
    "focusedCargoFilters": [
      "protocol::kiro",
      "kiro_compatible"
    ],
    "useNoDefaultFeatures": true
  },
  "compilation": {
    "compileLayer": "line_compile_gate",
    "lineFeature": "line-kiro-official-vendor-api",
    "binaryInclusionGroup": "kiro-official-vendor-api"
  },
  "implementation": {
    "protocolModule": "gateway/src/protocol/kiro.rs",
    "upstreamModule": "gateway/src/upstream/kiro.rs",
    "platformDeltaModule": "gateway/src/protocol/kiro.rs"
  }
}
