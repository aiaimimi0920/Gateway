{
  "schemaVersion": "gateway-line-manifest/v0-draft-1",
  "id": "accio-web-reverse-api",
  "identity": {
    "serviceProviderKey": "accio_platform",
    "serviceProviderLabel": "Accio Platform",
    "providerSurfaceKey": "accio",
    "providerSurfaceLabel": "Accio Web Reverse API",
    "protocolProfile": "accio",
    "implementationLine": "web_reverse_api",
