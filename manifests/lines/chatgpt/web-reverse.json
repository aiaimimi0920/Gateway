  "implementation": {
    "protocolModule": "gateway/src/protocol/chatgpt/web_reverse.rs",
    "upstreamModule": "gateway/src/upstream/chatgpt",
    "platformDeltaModule": "gateway/src/protocol/chatgpt/web_reverse.rs"
  }
