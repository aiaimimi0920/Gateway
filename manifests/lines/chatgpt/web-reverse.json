{
  "schemaVersion": "gateway-line-manifest/v0-draft-1",
  "id": "chatgpt-web-reverse",
  "identity": {
    "serviceProviderKey": "chatgpt_platform",
    "serviceProviderLabel": "ChatGPT Platform",
    "providerSurfaceKey": "chatgpt-web-reverse",
    "providerSurfaceLabel": "ChatGPT Web Reverse",
    "protocolProfile": "chatgpt_web_reverse",
    "implementationLine": "web_reverse",
    "adapter": "chatgpt_web_reverse_compatible",
    "sourceKind": "web_reverse_api",
    "executionMode": "browser_backed"
  },
  "capabilities": {
    "families": ["conversation", "models"],
    "supportsModelsEndpoint": true
  },
  "credentials": {
    "materialKinds": ["session_auth", "browser_state"],
    "samplePath": "docs/20-ai-gateway/examples/credentials/chatgpt/web_reverse/minimal.raw.sample.json",
