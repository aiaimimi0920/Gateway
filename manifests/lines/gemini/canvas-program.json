  },
  "implementation": {
    "protocolModule": "gateway/src/protocol/gemini/canvas_program_web_reverse",
    "upstreamModule": "gateway/src/upstream/gemini/canvas_program_web_reverse",
    "platformDeltaModule": "gateway/src/protocol/gemini/canvas_program_web_reverse"
  }
