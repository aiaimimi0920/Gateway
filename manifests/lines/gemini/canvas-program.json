    "serviceProviderLabel": "Gemini Platform",
    "providerSurfaceKey": "gemini-canvas-program-relay",
    "providerSurfaceLabel": "Gemini Canvas Program",
    "protocolProfile": "gemini_canvas_program_web_reverse_modular",
    "implementationLine": "program_owned",
    "adapter": "gemini_canvas_program_web_reverse_compatible",
    "sourceKind": "web_reverse_api",
