    "serviceProviderLabel": "Qwen Platform",
    "providerSurfaceKey": "qwen-web-chat",
    "providerSurfaceLabel": "Qwen Web Chat",
    "protocolProfile": "qwen_web_reverse",
    "implementationLine": "web_reverse",
    "adapter": "qwen_web_compatible",
    "sourceKind": "web_reverse_api",
