+        .all(|(headers, _)| headers["authorization"] == "Bearer rotation-2"));
+    assert_eq!(
+        calls
+            .iter()
+            .filter(|(_, v)| v["params"]["name"] == "luma_generate_image")
+            .count(),
+        2
+    );
+    f.close().await;
+}
